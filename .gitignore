# Secrets — DO NOT commit
.env
accounts.json
lessons.txt
# Per-machine launch wrappers (may embed credentials).
# The credential-free template at deploy/launch_template.bat IS tracked
# (see allowlist below).
launch.bat
launch_*.bat
!deploy/launch_template.bat
# Local diagnostic / one-off test scripts
/test_*.py

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Pipeline output (generated content; large)
data/chapters/
data/refined/
data/prompts/
data/images/
data/zips/
data/videos/
data/generated/
data/lessons/
data/reports/
data/logs/
data/ruvector.db
ruvector.db
# Ruflo MCP runtime store (created when the ruflo MCP server runs)
agentdb.rvf
agentdb.rvf.lock

# Browser persistent profiles (cookies, login state, user-specific)
data/chrome_keepalive_profile/
data/chrome_gemini_profile/
chrome_keepalive_profile/
chrome_gemini_profile/
chrome-chatgpt-cdp/
chrome-gemini-cdp/

# Submit/save runtime state (per-chapter, rebuilt on each run)
data/.cca/
.cca/

# Diagnostic / probe artifacts (screenshots, ad-hoc scripts)
_*.png
_*.cjs
_*.ps1
_*.py
_*.txt
_*.bat
_*.log
# Package markers are real source, not diagnostic artifacts — keep them tracked
# (the _*.py rule above otherwise matches __init__.py).
!**/__init__.py

# Per-host wrapper bat created by deploy/launch_template.bat caller
wrapper.bat
wrapper_*.bat

# Node deps
node_modules/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
.claude/
.claude-flow/
.swarm/
