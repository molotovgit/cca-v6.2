# =============================================================================
#  Creative Automation — .env template (CREDENTIAL-FREE)
# -----------------------------------------------------------------------------
#  Copy this file to the repo-root `.env`, then fill in the blank values.
#  (setup.bat / start.bat bootstrap `.env` from this template on first run.)
#
#  NEVER commit your real `.env` — it is gitignored. This template ships with
#  placeholder values only; do NOT put real secrets here.
#
#  Multi-account note: if you create `data/accounts.json` (see
#  config/examples/accounts.json.example), the auto-login rotator uses THAT
#  for ChatGPT/Gemini credentials and the CHATGPT_*/GEMINI_* values below
#  become the legacy single-account fallback.
# =============================================================================

# ─── REQUIRED — Notion ───────────────────────────────────────────────────────
# Notion internal-integration secret (starts with `ntn_` or `secret_`).
# Get it at https://www.notion.so/profile/integrations and grant the
# integration access to every chapter page the pipeline reads/writes.
NOTION_API_KEY=

# ─── REQUIRED (legacy fallback) — ChatGPT credentials ────────────────────────
# Used by auto_login.py when data/accounts.json is absent. Sign-in is one-time
# (the Chrome profile persists), so these may be left blank if you sign in
# manually in the port-9222 Chrome window.
CHATGPT_EMAIL=
CHATGPT_PASSWORD=

# ─── REQUIRED (legacy fallback) — Gemini credentials ─────────────────────────
# Used by auto_login.py when data/accounts.json is absent. Sign-in is one-time
# (the Chrome profile persists), so these may be left blank if you sign in
# manually in the port-9223 Chrome window.
GEMINI_EMAIL=
GEMINI_PASSWORD=

# ─── Chrome debug ports — leave as-is (scripts depend on these) ──────────────
# ChatGPT keep-alive Chrome CDP port (REFINE + PROMPTS stages attach here).
CDP_PORT=9222
# Gemini keep-alive Chrome CDP port (IMAGES stage + video workers attach here).
GEMINI_CDP_PORT=9223
# Flow (video) CDP port. Optional — falls back to GEMINI_CDP_PORT when unset.
# FLOW_CDP_PORT=9223

# =============================================================================
#  OPTIONAL RUN VARS — sensible defaults shown; uncomment only to override.
#  (start.bat normally sets the per-chapter ones from lessons.txt; these let
#   you run a single chapter without editing lessons.txt.)
# =============================================================================

# Notion link to the chapter/textbook root (overrides the in-code default).
# CCA_NOTION_URL=

# Target chapter selectors for a single-chapter run via run_pipeline.cjs.
# CCA_GRADE=7
# CCA_LANG=uz
# CCA_SUBJECT=jahon tarixi
# CCA_CHAPTER=1

# Opt-in video stage after IMAGES (1 = enable). Default off.
# CCA_ENABLE_VIDEO=0
# Max concurrent video generations, clamped to [1, 4]. Default 1.
# CCA_VIDEO_MAX_IN_FLIGHT=1
# Flow project URL for the video workers (else a built-in default is used).
# CCA_FLOW_PROJECT_URL=

# Dry-run the batch runner: print the parsed lesson list and exit. (1 = on)
# CCA_DRY_RUN=0
# Skip the Notion UPLOAD stage entirely. (1 = on)
# CCA_SKIP_UPLOAD=0
# Prefix for upload zip filenames (target a fresh name without overwriting).
# CCA_ZIP_PREFIX=
# Extra text prepended to every image prompt at submit time.
# CCA_PROMPT_PREAMBLE=

# ─── Optional — local Real-ESRGAN upscaler (Windows, GPU) ────────────────────
# Enable the upscaler stage. (1 = on) Default off.
# CCA_UPSCALE_ENABLED=0
# Path to realesrgan-ncnn-vulkan.exe.
# CCA_REALESRGAN_EXE=D:\tools\realesrgan\realesrgan-ncnn-vulkan.exe
# Real-ESRGAN model name.
# CCA_REALESRGAN_MODEL=realesrgan-x4plus
# Tile size for the model (192 fits in ~4 GB VRAM).
# CCA_UPSCALE_TILE=192
# Upscale-watcher poll interval, in milliseconds.
# CCA_UPSCALE_POLL_MS=3000

# ─── Test-only ───────────────────────────────────────────────────────────────
# Skip the initial submit in the autonomous orchestrator (used by tests).
# CCA_SKIP_INITIAL_SUBMIT=0
